# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
APP_NAME=Smart Comrade
DEBUG=False
ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://smartcomrade_user:password@localhost:5432/smartcomrade
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcomrade
DB_USER=smartcomrade_user
DB_PASSWORD=change_me
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ─────────────────────────────────────────────────────────────────
# AI assistance — one OpenAI-compatible client for every AI call
# ─────────────────────────────────────────────────────────────────
AI_ENABLED=True
AI_API_BASE=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL_CHEAP=llama-3.1-8b-instant
AI_MODEL_MID=llama-3.3-70b-versatile
AI_MODEL_PREMIUM=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1024
AI_RESOURCE_MIN_CONFIDENCE=0.6

# ─────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_SESSION_MINUTES=720
BOOTSTRAP_ADMIN_EMAILS=

# ─────────────────────────────────────────────────────────────
# Upload Pipeline
# ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
MAX_PAGES_PER_FILE=100
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,docx,doc,pptx,ppt

# ─────────────────────────────────────────────────────────────
# Storage (S3)
# ─────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=smartcomrade
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────
# OCR
# ─────────────────────────────────────────────────────────────
OCR_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
TESSERACT_CMD=

# ─────────────────────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@smartcomrade.com

# ─────────────────────────────────────────────────────────────
# SMS
# ─────────────────────────────────────────────────────────────
SMS_PROVIDER=console
SMS_ENABLED=False
AT_API_KEY=
AT_USERNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─────────────────────────────────────────────────────────────
# Redis & Celery
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────
# Payment (M-Pesa)
# ─────────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# ─────────────────────────────────────────────────────────────
# Payment gateway (card / bank)
# ─────────────────────────────────────────────────────────────
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_WEBHOOK_SECRET=change_me

# ─────────────────────────────────────────────────────────────
# Frontend URLs
# ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
PWA_URL=http://localhost:3001